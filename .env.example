# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (Default uses SQLite in instance/campusconnect.db)
# For production PostgreSQL: DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///instance/campusconnect.db

# Frontend URL (For production CORS configuration)
FRONTEND_URL=http://localhost:5000

